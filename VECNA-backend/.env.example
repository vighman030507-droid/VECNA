# ==============================================================================
# VECNA // Stranger Things HUD Assistant — Configuration & Environment Variables
# ==============================================================================
# Developed by Vighnesh Singh (VESIT Mumbai)
# Fill in your own keys below. NEVER commit your actual .env file to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PRIMARY AI INFERENCE (Groq — Ultra Low Latency)
# ------------------------------------------------------------------------------
# Get your free Groq API key: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_CHAT_MODEL=llama-3.3-70b-versatile

# ------------------------------------------------------------------------------
# 2. NEURAL HOT-SWAPPING (Automatic Failover on Rate Limits or Outages)
# ------------------------------------------------------------------------------
# Primary Fallback 1: Google Gemini (Free Tier)
# Get your key: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Primary Fallback 2: NVIDIA NIM (Free Trial / Developer Cloud)
# Get your key: https://build.nvidia.com/
NVIDIA_API_KEY=your_nvidia_api_key_here

# Primary Fallback 3: Mistral AI (Free Tier)
# Get your key: https://console.mistral.ai/
MISTRAL_API_KEY=your_mistral_api_key_here

# Custom Generic OpenAI-compatible Backups (Optional)
BACKUP_1_BASE_URL=https://integrate.api.nvidia.com/v1
BACKUP_1_API_KEY=your_backup_1_api_key_here
BACKUP_1_MODEL=meta/llama-3.3-70b-instruct

BACKUP_2_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
BACKUP_2_API_KEY=your_backup_2_api_key_here
BACKUP_2_MODEL=gemini-2.5-flash

# ------------------------------------------------------------------------------
# 3. TELEGRAM REMOTE UPLINK (Control Vecna from your phone)
# ------------------------------------------------------------------------------
# Create a bot via @BotFather on Telegram: https://t.me/BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# Get your numeric User ID via @userinfobot: https://t.me/userinfobot
TELEGRAM_ALLOWED_UID=your_numeric_telegram_user_id_here

# ------------------------------------------------------------------------------
# 4. GMAIL AUTHORITY (Read/Send Notifications) (Optional)
# ------------------------------------------------------------------------------
# Enable 2-Step Verification on your Google Account, then generate an App Password:
# https://myaccount.google.com/apppasswords
GMAIL_ADDRESS=your_email@gmail.com
GMAIL_APP_PASSWORD=your_16_digit_google_app_password

# ------------------------------------------------------------------------------
# 5. SERVER NETWORKING & LOCAL BRIDGE
# ------------------------------------------------------------------------------
VECNA_BACKEND_HOST=127.0.0.1
VECNA_BACKEND_PORT=8765
VECNA_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:1420,http://127.0.0.1:1420
VECNA_LOCAL_ACTIONS_ENABLED=true
