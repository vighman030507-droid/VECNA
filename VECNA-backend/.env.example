# Obtain this from your own Groq account. Never commit the real .env file.
GROQ_API_KEY=your_actual_groq_api_key_here
GROQ_CHAT_MODEL=llama-3.3-70b-versatile

# Local development defaults. Set JARVIS_ALLOWED_ORIGINS to your exact web app
# domain when deploying; never use a wildcard origin.
JARVIS_BACKEND_HOST=127.0.0.1
JARVIS_BACKEND_PORT=8765
JARVIS_ALLOWED_ORIGINS=http://localhost:1420,http://127.0.0.1:1420

# Optional Windows-only local bridge. Keep false for browser-only deployments.
JARVIS_LOCAL_ACTIONS_ENABLED=false
